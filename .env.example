# HARLAB Environment Configuration
# Copy this file to `.env` (never commit `.env` to Git).
# All AI keys are OPTIONAL: the deterministic quantitative engine, simulation lab,
# and research workbench operate fully without any AI credentials.

# Three-provider AI failover order (comma-separated: gemini, groq, openrouter)
AI_PROVIDER_PRIORITY=gemini,groq,openrouter

# Provider A: Google Gemini (https://ai.google.dev/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Provider B: Groq (https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Provider C: OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Allowed frontend origins for FastAPI CORS
HARLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
